# =====================================================================
# REELSPACE ENVIRONMENT CONFIGURATION
# =====================================================================

# Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Recommendation Engine Tuning Defaults (Optional Overrides)
# All weights are dynamically calibrated inside the platform
RECOMMENDATION_EXPLORATION_RATIO=0.25
SHORT_TERM_DECAY_HALF_LIFE_DAYS=2.0
LONG_TERM_DECAY_HALF_LIFE_DAYS=14.0

# Content Ingestion Providers
# Meta Official oEmbed App Token (Optional - for high-throughput public reel metadata)
# Obtain from developers.facebook.com: App Dashboard -> Products -> Instagram oEmbed
META_APP_ID=
META_CLIENT_TOKEN=

# Application Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
